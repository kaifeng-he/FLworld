{
  "name": "hkf-cl-world-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create hkf-cl-world",
    "d1:migrate:local": "wrangler d1 migrations apply hkf-cl-world --local",
    "d1:migrate": "wrangler d1 migrations apply hkf-cl-world --remote",
    "check": "node --check src/server.js"
  },
  "devDependencies": {
    "wrangler": "^4.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
